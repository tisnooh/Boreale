# ===== BORÉALE frontend — variables d'environnement =====
# Copier ce fichier vers .env.local (jamais commiter .env.local).
# AUCUN SECRET côté frontend : pas de STRIPE_SECRET_KEY, pas de SUPABASE_SERVICE_ROLE_KEY,
# pas de EMAIL_API_KEY ici (elles vivent uniquement dans backend/.env).

# Mode de fonctionnement du site :
#   preview (défaut) : catalogue de démonstration local, aucun service requis,
#                      bandeau « Mode preview » affiché, aucun faux succès business.
#   live             : consomme l'API backend réelle (NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_SITE_MODE=preview

# URL de l'API backend (utile en mode live)
# Local : http://localhost:4000 — Production : https://api.domain.com (sans slash final)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL publique du site (canonical, sitemap, OG, JSON-LD)
# Local : http://localhost:3000 — Production : https://domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
