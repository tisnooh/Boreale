# ===== BORÉALE backend — variables d'environnement =====
# Copier ce fichier vers .env.local (jamais commiter .env.local)

# URL publique du frontend (CORS). En production : https://domain.com (sans slash final).
# Plusieurs origines possibles séparées par des virgules.
FRONTEND_URL=http://localhost:3000

# Supabase — https://supabase.com/dashboard → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service-role : BACKEND UNIQUEMENT, ne jamais exposer ni mettre dans le frontend
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — mode TEST au lancement (https://dashboard.stripe.com/test/apikeys)
# Clé secrète : BACKEND UNIQUEMENT
STRIPE_SECRET_KEY=
# Secret du webhook (stripe listen --forward-to ... ou Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# Emails — Resend (https://resend.com). Sans clé en dev : les emails sont loggés en console.
EMAIL_API_KEY=
EMAIL_FROM=BORÉALE <bonjour@votre-domaine.fr>
# Adresse qui reçoit les notifications (commandes, contact)
NOTIFY_EMAIL=

# Secret de signature des JWT clients/admins — valeur longue et aléatoire (ex: openssl rand -hex 32)
JWT_SECRET=

# Secret du cron Vercel (header Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Port du serveur local (défaut 4000)
PORT=4000

# Mode dev ou production : en production les cookies sont SameSite=None; Secure
NODE_ENV=development

# Nom/URL publique de la marque (utilisés dans les emails et URLs Stripe)
BRAND_NAME=BORÉALE
PUBLIC_SITE_URL=http://localhost:3000
